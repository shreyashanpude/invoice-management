# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart_invoice_db
# For Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_invoice_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration
# Supported: openai, gemini, groq
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash

# OpenAI (if AI_PROVIDER=openai)
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o

# Groq (if AI_PROVIDER=groq)
# AI_API_KEY=gsk_...
# AI_MODEL=llama3-70b-8192

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20
